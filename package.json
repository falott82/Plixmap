{
  "name": "plixmap",
  "description": "Collaborative workspace planning with floor plans, desks, racks, and network links.",
  "license": "MIT",
  "homepage": "https://www.plixmap.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/falott82/Plixmap.git"
  },
  "bugs": {
    "url": "https://github.com/falott82/Plixmap/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://www.paypal.com/paypalme/falott82"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:eslint:ci": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 355",
    "test": "node --test scripts/*.test.cjs",
    "test:unit": "vitest run",
    "test:e2e:smoke": "node scripts/e2e-smoke.cjs",
    "test:e2e:playwright": "npx playwright test",
    "lint:i18n": "node scripts/lint-i18n.cjs",
    "backup:db": "node scripts/db-backup.cjs",
    "release:db:export": "node scripts/release-db-export.cjs",
    "sensitive:check": "node scripts/check-sensitive-data.cjs",
    "sensitive:check:staged": "node scripts/check-sensitive-data.cjs --staged",
    "hooks:install": "git config core.hooksPath .githooks",
    "release:check": "node scripts/check-release-version.cjs",
    "quality:check": "npm run sensitive:check && npm run lint && npm run lint:eslint:ci && npm run test && npm run test:unit && npm run build && npm run release:check",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "start": "node server/index.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "ldapts": "^9.2.0",
    "nodemailer": "^10.0.10",
    "sanitize-html": "^2.17.7",
    "speakeasy": "^2.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@lexical/history": "^0.50.0",
    "@lexical/html": "^0.50.0",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@lexical/table": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "classnames": "^2.5.1",
    "dompurify": "^3.4.15",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html2canvas": "^1.4.1",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "konva": "^10.5.0",
    "lexical": "^0.50.0",
    "lucide-react": "^1.45.0",
    "nanoid": "^6.0.1",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.2.7",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "use-image": "^1.1.4",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0",
    "serialize-javascript": "^7.0.4",
    "qs": "^6.15.2",
    "lodash": "^4.17.23",
    "path-to-regexp": "^8.4.2"
  },
  "version": "3.8.0"
}
